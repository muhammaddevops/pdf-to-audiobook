# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# --- Required ---

# ElevenLabs — text-to-speech narration (narrate.py)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Storyteller voice. Default here is "Daniel" (British male broadcaster).
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# TTS model. Default eleven_multilingual_v2. Set to eleven_v3 to A/B the mixed
# Arabic/English read (v3 caps requests at 3000 chars and drops SSML break tags).
# ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI — GPT-4o vision OCR (transcribe.py, benchmark_ocr.py)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — Claude Opus. arabize.py uses it for the long-tail term conversion
# (only for pages the deterministic map in translit_map.py doesn't fully cover; a
# book whose vocabulary the map covers needs no key). Also the opus_ocr.py fallback.
# ANTHROPIC_API_KEY=

# --- Optional (fallbacks / experimental paths) ---

# Baseer OCR — specialist Arabic OCR fallback (baseer_ocr.py)
# BASEER_API_KEY=
# BASEER_BASE_URL=https://api.baseerocr.com/v1
# BASEER_MODEL=qwen2.5-vl
# BASEER_TRANSPORT=openai

# Pinecone — for future canonical-text retrieval
# PINECONE_API_KEY=
