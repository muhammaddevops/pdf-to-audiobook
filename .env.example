# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# --- Required ---

# ElevenLabs — text-to-speech narration (narrate.py)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Storyteller voice. Default here is "Daniel" (British male broadcaster).
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# OpenAI — GPT-4o vision OCR (transcribe.py, benchmark_ocr.py)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Optional (fallbacks / experimental paths) ---

# Anthropic — Claude Opus vision fallback for unresolved Arabic blocks (opus_ocr.py)
# ANTHROPIC_API_KEY=

# Baseer OCR — specialist Arabic OCR fallback (baseer_ocr.py)
# BASEER_API_KEY=
# BASEER_BASE_URL=https://api.baseerocr.com/v1
# BASEER_MODEL=qwen2.5-vl
# BASEER_TRANSPORT=openai

# Pinecone — for future canonical-text retrieval
# PINECONE_API_KEY=
